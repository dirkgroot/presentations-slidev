{
  "type": "module",
  "name": "slidev-theme-avisi",
  "version": "0.1.0",
  "description": "Avisi-branded local Slidev theme (Poppins, white background, dark-blue headings, light-blue accents)",
  "author": "Dirk Groot",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.1.0"
  },
  "dependencies": {
    "@slidev/types": "^53.1.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@slidev/cli": "^53.1.0"
  },
  "//": "Docs: https://sli.dev/guide/write-theme.html — playground deck: decks/avisi-theme-example/",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Poppins",
        "serif": "Poppins",
        "mono": "Fira Code",
        "weights": "400, 600"
      }
    }
  }
}
